{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.joyautomart/mcp",
  "title": "JOY Automart",
  "description": "Search car parts and used/reconditioned vehicle listings in Bangladesh (BDT prices, stock).",
  "version": "1.2.2",
  "websiteUrl": "https://www.joyautomart.com/developers",
  "repository": {
    "url": "https://github.com/www-joyautomart-com/mcp-server",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.joyautomart.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional buyer token: 'Bearer joyagt_...'",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
